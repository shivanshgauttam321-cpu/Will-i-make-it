# =====================================================================
# EV "WILL I MAKE IT?" - PRODUCTION & SERVICE CONFIGURATION TEMPLATE
# Copy to .env and configure your service credentials.
# =====================================================================

# ---------------------------------------------------------------------
# 1. NEO4J GRAPH DATABASE
# ---------------------------------------------------------------------
NEO4J_ENABLED=false
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j
NEO4J_AUTO_SEED=false
NEO4J_CONNECTION_TIMEOUT=15
NEO4J_MAX_CONNECTION_LIFETIME=3600
NEO4J_MAX_CONNECTION_POOL_SIZE=50

# ---------------------------------------------------------------------
# 2. SARVAM AI SPEECH & CONVERSATIONAL INTERACTION
# ---------------------------------------------------------------------
SARVAM_ENABLED=false
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_MODEL=saarika:v2
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_DEFAULT_LANGUAGE=hi-IN

# ---------------------------------------------------------------------
# 3. EXTERNAL CHARGING PROVIDERS (OPTIONAL)
# ---------------------------------------------------------------------
OPEN_CHARGE_MAP_API_KEY=your-open-charge-map-api-key
BEE_EV_YATRA_API_KEY=your-bee-ev-yatra-api-key

# ---------------------------------------------------------------------
# 4. ROUTING & ELEVATION ENGINES
# ---------------------------------------------------------------------
OSRM_SERVER_URL=https://router.project-osrm.org
OPEN_METEO_ELEVATION_URL=https://api.open-meteo.com/v1/elevation
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast

# ---------------------------------------------------------------------
# 5. APPLICATION STORAGE & SECURITY
# ---------------------------------------------------------------------
SQLITE_PATH=willimake.db
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
